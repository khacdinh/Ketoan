{
  "name": "so-thu-chi-ke-toan",
  "version": "1.0.0",
  "description": "Phần mềm kế toán thu chi, quản lý dự án, nhà cung cấp và in phiếu thu/chi",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/run.js",
    "build:assets": "node scripts/build-assets.js",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch",
    "build": "npm run build:assets && npm run build:css"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "lucide-static": "^1.50.0",
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.10.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3"
  }
}
